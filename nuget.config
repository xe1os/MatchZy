<?xml version="1.0" encoding="utf-8"?>
<!--
  Two packages come from the local "packages" folder in this repo instead of nuget.org:

  - CounterStrikeSharp.API 1.0.398: the fork build (1.0.39x surface + Trace natives).
    nuget.org tops out at 1.0.371 and lacks Trace.
  - CS2MenuManager 1.0.42: a net10.0 build. nuget.org only has the net8.0 build.

  Both are compile-time only (ExcludeAssets=runtime in MatchZy.csproj); the server loads its own
  copies at runtime. packageSourceMapping pins ONLY these two names to the local folder, so
  CS2MenuManager's transitive dependency on CounterStrikeSharp.API also resolves to the fork
  build. Everything else comes from nuget.org. No credentials are needed.

  To bump either one, drop the new .nupkg into packages/, remove the old one, and update the
  version in MatchZy.csproj (CssApiVersion / the CS2MenuManager PackageReference).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="packages" />
  </packageSources>
  <!-- Vulnerability audit: only query nuget.org. A local folder source has no vulnerability
       endpoint and would only produce NU1900 warnings. -->
  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="CS2MenuManager" />
      <package pattern="CounterStrikeSharp.API" />
    </packageSource>
  </packageSourceMapping>
</configuration>
